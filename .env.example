# URL pubblico del sito (usato per canonical, sitemap, link nelle email e controllo CSRF)
SITE_URL=https://lattaiponticorvo.com

# Database. Vuoto in sviluppo = Postgres locale PGlite in ./.data. In produzione: URL Postgres.
DATABASE_URL=

# Cartella dei file caricati dall'admin (foto). In produzione deve stare su un volume persistente.
UPLOAD_DIR=./uploads

# Creazione del PRIMO amministratore: valore segreto a tua scelta, richiesto da /admin/setup.
# Dopo aver creato l'account puoi rimuoverlo.
ADMIN_SETUP_TOKEN=

# Stripe (usa le chiavi di TEST finché non sei pronto: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email transazionali (Resend). Senza chiave le email vengono solo stampate in console.
RESEND_API_KEY=
MAIL_FROM=info@lattaiponticorvo.it
ADMIN_NOTIFY_EMAIL=info@lattaiponticorvo.it
