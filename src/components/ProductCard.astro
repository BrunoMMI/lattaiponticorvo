---
import { priceLabel } from '../lib/format';
import { inStock } from '../lib/shop';
import { mediaAttrs } from '../lib/media';

interface Props { p: any; eager?: boolean; level?: 2 | 3 }
const { p, eager = false, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const price = p.salePriceCents ?? p.priceCents;
const available = inStock(p);
---
<li class="group rounded-[var(--radius-card)] bg-white shadow-soft overflow-hidden">
  <a href={`/shop/${p.slug}`} class="block" aria-label={p.name}>
    {p.images[0]
      ? <img {...mediaAttrs(p.images[0].path, '(min-width: 1024px) 380px, (min-width: 640px) 45vw, 100vw')} alt={p.images[0].alt || p.name} width={p.images[0].w ?? 800} height={p.images[0].h ?? 600} class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading={eager ? 'eager' : 'lazy'} decoding="async" />
      : <div class="photo-slot aspect-[4/3]" role="img" aria-label={`Foto di ${p.name}, in arrivo`}>Foto in arrivo</div>}
    <div class="p-4">
      <Heading class="text-lg">{p.name}</Heading>
      {p.shortDescription && <p class="text-sm text-ink-soft mt-1 line-clamp-2 text-left">{p.shortDescription}</p>}
      <p class="mt-3 font-semibold">
        {available ? (price != null ? <>{p.salePriceCents != null && <s class="text-ink-soft font-normal mr-1">{priceLabel(p.priceCents, p.sellUnit)}</s>}{priceLabel(price, p.sellUnit)}</> : null) : <span class="text-bordeaux-700">Non disponibile</span>}
      </p>
    </div>
  </a>
</li>
