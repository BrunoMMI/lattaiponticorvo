---
import Account from '../../layouts/Account.astro';
import { setPasswordWithToken, startCustomerSession, tokenOwner } from '../../lib/customer-auth';
import { passwordProblem } from '../../lib/auth';
import { tooMany } from '../../lib/ratelimit';

export const prerender = false;
Astro.response.headers.set('Referrer-Policy', 'no-referrer'); // il token è nell'URL
const token = Astro.url.searchParams.get('token') ?? '';
const valid = !!token && !!(await tokenOwner(token));
let error = '';
if (valid && Astro.request.method === 'POST') {
  const pw = String((await Astro.request.formData()).get('password') ?? '');
  const problem = passwordProblem(pw);
  if (tooMany(`cpw:${Astro.clientAddress}`, 10)) error = 'Troppi tentativi.';
  else if (problem) error = problem;
  else {
    const id = await setPasswordWithToken(token, pw);
    if (id) { await startCustomerSession(Astro.cookies, id); return Astro.redirect('/account'); }
    error = 'Il link non è più valido.';
  }
}
---
<Account title="Scegli la password" narrow>
  <div class="grid gap-4 rounded-[var(--radius-card)] bg-white p-6 shadow-soft">
    <h1 class="text-3xl">Scegli la password</h1>
    {!valid ? <>
      <p role="alert" class="rounded-lg bg-bordeaux-50 p-3 text-sm text-bordeaux-700">Il link non è valido o è scaduto.</p>
      <a class="btn btn-ghost" href="/account/registrati">Richiedine uno nuovo</a>
    </> : (
      <form method="post" class="grid gap-4">
        {error && <p role="alert" class="rounded-lg bg-bordeaux-50 p-3 text-sm text-bordeaux-700">{error}</p>}
        <label class="grid gap-1 text-sm font-medium">Nuova password (min. 12 caratteri, con maiuscole, minuscole e numeri)<input name="password" type="password" minlength="12" required autocomplete="new-password" class="min-h-11 rounded-lg border border-line px-3 font-normal" /></label>
        <button class="btn btn-primary">Salva e accedi</button>
      </form>
    )}
  </div>
</Account>
