---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { eq } from 'drizzle-orm';
import { getDb, schema } from '../../db';
import { euro } from '../../lib/pricing';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const sid = Astro.url.searchParams.get('session_id') ?? '';
const [o] = /^cs_[A-Za-z0-9_]{10,200}$/.test(sid) ? await (await getDb()).select().from(schema.orders).where(eq(schema.orders.stripeSessionId, sid)) : [];
// La conferma si basa SOLO sullo stato scritto dal webhook verificato, mai sul semplice ritorno da Stripe.
const paid = !!o && ['paid', 'preparing', 'shipped', 'delivered'].includes(o.status);
---
<Base title="Conferma ordine" description="Stato del tuo ordine." noindex>
  <SiteHeader />
  <main id="main" class="container-x py-16 max-w-2xl text-center">
    {!o ? <>
      <h1 class="text-3xl">Ordine non trovato</h1><p class="mt-3 text-ink-soft">Il link non è valido. Se hai pagato, riceverai una email di conferma.</p>
    </> : paid ? <>
      <h1 class="text-4xl">Grazie per il tuo ordine!</h1>
      <p class="mt-3 text-lg">Ordine <strong>#{o.number}</strong> · {euro(o.totalCents)}</p>
      <p class="mt-2 text-ink-soft">Il pagamento è stato confermato. Ti scriveremo a <strong>{o.email}</strong> per ogni aggiornamento.</p>
      <script is:inline>try{localStorage.removeItem('lp_cart_v1');sessionStorage.removeItem('lp_coupon')}catch(e){}</script>
    </> : o.status === 'cancelled' ? <>
      <h1 class="text-3xl">Ordine non completato</h1><p class="mt-3 text-ink-soft">Il pagamento non è andato a buon fine e nulla è stato addebitato. Puoi riprovare quando vuoi.</p>
      <a href="/carrello" class="btn btn-primary mt-6">Torna al carrello</a>
    </> : <>
      <h1 class="text-3xl">Stiamo confermando il pagamento…</h1>
      <p class="mt-3 text-ink-soft" role="status">Ordine #{o.number}. Questa pagina si aggiorna da sola: non serve ripetere il pagamento.</p>
      <meta http-equiv="refresh" content="4" />
    </>}
    <a href="/shop" class="btn btn-ghost mt-8">Continua gli acquisti</a>
  </main>
  <SiteFooter />
</Base>
